::-webkit-scrollbar {
  width: 6px;
  height: 6px;
}

::-webkit-scrollbar-track {
  background: #f1f1f1;
}

::-webkit-scrollbar-thumb {
  background: #111111;
  border-radius: 3px;
}


.custom-scrollbar::-webkit-scrollbar {
  display: none;
}

.custom-scrollbar {
  -ms-overflow-style: none;  
  scrollbar-width: none;     
}


.drawer-transition {
  transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
}


@keyframes moveRider {
  0% { top: 75%; left: 15%; transform: scale(0.8); }
  25% { top: 60%; left: 35%; }
  50% { top: 45%; left: 50%; transform: scale(1.1); }
  75% { top: 30%; left: 68%; }
  100% { top: 20%; left: 82%; transform: scale(1); }
}

.animate-rider {
  animation: moveRider 14s infinite ease-in-out;
}


@keyframes pulseGlow {
